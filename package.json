{
  "name": "astro-sub-analyser",
  "productName": "Astronomy Sub Analyser",
  "version": "0.4.21",
  "description": "Offline astronomy frame analysis and selection tool.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "test": "node tests/moon-calculation.test.js && node tests/worker-fits.test.js",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:release:mac": "electron-builder --config electron-builder.release.cjs --mac",
    "dist:release:win": "electron-builder --config electron-builder.release.cjs --win"
  },
  "build": {
    "appId": "com.moonconjunction.astrosubanalyser",
    "productName": "Astronomy Sub Analyser",
    "files": [
      "index.html",
      "styles.css",
      "i18n.js",
      "moon-calculation.js",
      "app.js",
      "wasm/*.wasm",
      "assets/**/*",
      "electron/**/*"
    ],
    "asar": {
      "disableIntegrity": false
    },
    "electronFuses": {
      "version": "1",
      "strictlyRequireAllFuses": true,
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": true,
      "wasmTrapHandlers": true
    },
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "Astronomy Sub Analyser ${version}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics"
    }
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  }
}
